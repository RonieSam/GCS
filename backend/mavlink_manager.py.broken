"""
Phase 6 — MAVLink connection manager.

This is the first-milestone piece from the Phase 6 plan: get

    GCS -> MAVLink -> ArduPilot

working reliably, before anything about missions. Concretely:

- Open (and keep re-opening on failure) a MAVLink connection to
  MAVLINK_CONNECTION (SITL's GCS UDP output, e.g. udp:127.0.0.1:14550).
- Track connection health via a SafetyStateMachine (safety_manager.py) —
  DISCONNECTED / CONNECTING / CONNECTED / HEARTBEAT_LOST — rather than a
  single bool, so the GCS can tell "never connected" apart from "was
  connected, link just dropped".
- Keep a `vehicle_state` dict (mavlink_telemetry.py) updated from every
  incoming message. This is the "central source of truth" the plan
  describes in section 14 — /api/status and the future telemetry
  websocket (Phase 7) both read from it.

Runs its own background thread (start_background/stop_background) so a
missing/unreachable SITL never blocks the FastAPI process from starting
or serving the parts of the API that don't need a vehicle — matching how
main.py already treats MAVLink-dependent endpoints as optional (Phase 5's
501 stubs), just now backed by a real connection attempt instead of an
always-False status.
"""

import threading
import time

from pymavlink import mavutil

import mavlink_commands
import mavlink_telemetry
from safety_manager import SafetyStateMachine

_POLL_INTERVAL_S = 0.1  # how often the background loop drains incoming messages


class MAVLinkManager:
    def __init__(
        self,
        connection_string,
        connect_timeout_s=10,
        heartbeat_lost_s=5,
        reconnect_interval_s=3,
        stream_rate_hz=4,
    ):
        self.connection_string = connection_string
        # How long a single connect attempt blocks waiting for the *first*
        # heartbeat before giving up and retrying.
        self._connect_timeout_s = connect_timeout_s
        # Once connected, how long without a heartbeat before the link is
        # considered lost (see SafetyStateMachine) — normally much shorter
        # than connect_timeout_s, since ArduPilot heartbeats at ~1Hz once
        # a link is actually up.
        self._heartbeat_lost_s = heartbeat_lost_s
        self._reconnect_interval_s = reconnect_interval_s
        self._stream_rate_hz = stream_rate_hz

    self._conn = None
        self._safety = SafetyStateMachine(heartbeat_lost_s)
        self._state = mavlink_telemetry.new_vehicle_state()
        self._lock = threading.Lock()
        self._command_queue = queue.Queue()   # NEW

        self._thread = None
        self._stop_event = threading.Event()
    # -- lifecycle -----------------------------------------------------

    def start_background(self):
        """Start the connect/reconnect/read loop on a daemon thread. Safe
        to call once at app startup; a no-op if already running."""
        if self._thread is not None and self._thread.is_alive():
            return
        self._stop_event.clear()
        self._thread = threading.Thread(target=self._run_loop, daemon=True)
        self._thread.start()

    def stop_background(self):
        self._stop_event.set()
        if self._thread is not None:
            self._thread.join(timeout=2)
        self.disconnect()

    def connect(self):
        """Synchronous, one-shot connect attempt (blocks up to
        connect_timeout_s). Returns True on success. The running app
        should prefer start_background(); this exists for scripts/tests
        that want a direct call matching the manager interface."""
        self._attempt_connect()
        return self._conn is not None

    def disconnect(self):
        if self._conn is not None:
            try:
                self._conn.close()
            except Exception:
                pass
        self._conn = None
        with self._lock:
            self._safety.disconnect()
            self._state = mavlink_telemetry.new_vehicle_state()

    def is_connected(self):
        return self._safety.is_connected()

    @property
    def link_state(self):
        """The full DISCONNECTED/CONNECTING/CONNECTED/HEARTBEAT_LOST
        state — more informative than the is_connected() bool for
        surfacing in the UI."""
        return self._safety.state

    def wait_heartbeat(self, timeout=None):
        if self._conn is None:
            return None
        return self._conn.wait_heartbeat(
            timeout=timeout if timeout is not None else self._connect_timeout_s
        )

    def get_vehicle_state(self):
        with self._lock:
            return dict(self._state)

    def send_command(self, name, **kwargs):
        if self._conn is None or not self.is_connected():
            raise RuntimeError("Cannot send command: no active MAVLink connection.")

        if name == "arm":
            mavlink_commands.arm(self._conn)
        elif name == "disarm":
            mavlink_commands.disarm(self._conn)
        elif name == "set_mode":
            return self._send_set_mode_and_wait(kwargs["mode"])
        else:
            raise ValueError(f"Unknown command {name!r}")

    def _send_set_mode_and_wait(self, mode_name, timeout_s=3):
        """Queue a mode change for the background thread and block until
        it reports PX4's COMMAND_ACK (or a timeout). Routed through the
        background thread because it — and only it — is allowed to read
        from the MAVLink connection; see mavlink_commands.set_mode()."""
        result_box = {}
        done = threading.Event()
        self._command_queue.put(
            ("set_mode", {"mode": mode_name, "timeout_s": timeout_s}, result_box, done)
        )
        if not done.wait(timeout_s + 1):
            raise mavlink_commands.CommandTimeout(f"set_mode({mode_name})", timeout_s)
        if "error" in result_box:
            raise result_box["error"]
        return result_box["result"]
    # -- background loop -------------------------------------------------
def _run_loop(self):
        while not self._stop_event.is_set():
            if self._conn is None:
                self._attempt_connect()
                if self._conn is None:
                    self._stop_event.wait(self._reconnect_interval_s)
                    continue

            self._process_command_queue()   # NEW — before draining telemetry
            self._drain_incoming()

            with self._lock:
                self._safety.check_timeout()
                self._state["connected"] = self._safety.is_connected()

            self._stop_event.wait(_POLL_INTERVAL_S)

    def _process_command_queue(self):
        """Run any queued commands that need to read an ACK. Executes on
        this (the connection-owning) thread only."""
        while True:
            try:
                name, kwargs, result_box, done = self._command_queue.get_nowait()
            except queue.Empty:
                return
            try:
                if self._conn is None:
                    raise RuntimeError("Cannot send command: no active MAVLink connection.")
                if name == "set_mode":
                    result_box["result"] = mavlink_commands.set_mode(
                        self._conn, kwargs["mode"], timeout_s=kwargs.get("timeout_s", 3)
                    )
                else:
                    raise ValueError(f"Unknown queued command {name!r}")
            except Exception as e:
                result_box["error"] = e
            finally:
                done.set()

    def _attempt_connect(self):
        with self._lock:
            self._safety.connecting()

        try:
            conn = mavutil.mavlink_connection(self.connection_string)
        except Exception:
            with self._lock:
                self._safety.disconnect()
            self._conn = None
            return

        heartbeat = self._wait_heartbeat_interruptible(conn, self._connect_timeout_s)
        if heartbeat is None:
            try:
                conn.close()
            except Exception:
                pass
            with self._lock:
                self._safety.disconnect()
            self._conn = None
            return

        with self._lock:
            mavlink_telemetry.update_from_message(self._state, heartbeat, conn)
            self._safety.heartbeat_received()
            self._state["connected"] = True

        try:
            mavlink_commands.request_data_streams(conn, self._stream_rate_hz)
        except Exception:
            # Streaming is a convenience, not a precondition for
            # "connected" — a heartbeat alone proves the link works.
            pass

        self._conn = conn

    def _wait_heartbeat_interruptible(self, conn, timeout_s, step_s=1.0):
        """Like conn.wait_heartbeat(), but polls in short steps and checks
        _stop_event between them. A plain conn.wait_heartbeat(timeout=10)
        blocks the thread uninterruptibly for up to 10s, which would make
        stop_background() (and its socket cleanup) wait just as long —
        this keeps shutdown responsive regardless of connect_timeout_s."""
        deadline = time.time() + timeout_s
        while time.time() < deadline:
            if self._stop_event.is_set():
                return None
            msg = conn.recv_match(type="HEARTBEAT", blocking=True, timeout=step_s)
            if msg is not None:
                return msg
        return None

    def _drain_incoming(self):
        """Process every message currently buffered, without blocking —
        called once per loop iteration so a burst of messages doesn't
        make the manager fall behind real time."""
        while True:
            try:
                msg = self._conn.recv_match(blocking=False)
            except Exception:
                # Socket-level failure — treat as a dropped link and let
                # the next loop iteration reconnect.
                self._conn = None
                with self._lock:
                    self._safety.disconnect()
                return

            if msg is None:
                return
            if msg.get_type() == "BAD_DATA":
                continue

            with self._lock:
                mavlink_telemetry.update_from_message(self._state, msg, self._conn)
                if msg.get_type() == "HEARTBEAT":
                    self._safety.heartbeat_received()

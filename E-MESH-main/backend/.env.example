# E-Mesh Environment Configuration
# Copy this to .env and fill in real values

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./e_mesh.db
# For PostgreSQL (future):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/emesh

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@Mesh2025
ADMIN_EMAIL=admin@e-mesh.local
ADMIN_FULL_NAME=System Administrator

# ── Rate Limiting ─────────────────────────────────────────────────────────────
SOS_RATE_LIMIT=3/minute
API_RATE_LIMIT=100/minute

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

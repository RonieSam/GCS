# =============================================================================
# E-MESH Firmware — Default SDK Configuration
# =============================================================================
# These values override ESP-IDF defaults to enable IP forwarding / NAPT
# which is required for ESP-MESH-LITE to transparently route HTTP traffic.
# =============================================================================

# --- lwIP: Enable IP Forwarding and NAPT ---
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# --- Wi-Fi ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- Log Level (default to INFO, override with menuconfig) ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# --- Partition Table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Stack sizes ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Auto-added by fixes ---
CONFIG_MESH_LITE_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Disable iot_bridge ethernet ---
CONFIG_BRIDGE_ETHERNET_NETIF_ENABLE=n
CONFIG_BRIDGE_EXTERNAL_NETIF_ETHERNET=n
CONFIG_BRIDGE_DATA_FORWARDING_NETIF_ETHERNET=n

# --- Fix Tmr Svc Stack Overflow ---
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# --- E-MESH Custom Defaults ---
CONFIG_EMESH_SERVER_IP="192.168.137.1"
CONFIG_EMESH_HEARTBEAT_INTERVAL_SEC=5
